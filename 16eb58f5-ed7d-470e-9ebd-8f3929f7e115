.content{padding:28px;max-width:1450px;margin:auto}.view{display:none}.view.active{display:block}.dash-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:25px}.dash-head h1{font-size:42px;letter-spacing:-.07em;margin:5px 0}.sub{color:#777;font-size:12px}.grid{display:grid;grid-template-columns:1.25fr .75fr;gap:15px}.panel{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 10px 30px rgba(0,0,0,.025)}.panel h3{margin:0;font-size:12px}.panel-label{font:9px "Space Mono";color:#888;letter-spacing:.12em;text-transform:uppercase}
