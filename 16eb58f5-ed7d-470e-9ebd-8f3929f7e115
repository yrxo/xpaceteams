/* V51.1 — REAL MOBILE SWIPE / SCROLL FIX */
html, body {
  touch-action: pan-y pinch-zoom !important;
  -webkit-overflow-scrolling: touch !important;
  overscroll-behavior-y: auto !important;
}
body {
  overflow-y: auto !important;
  overflow-x: hidden !important;
}
#app.app-shell,
.workspace-main,
.workspace-content {
  touch-action: pan-y !important;
}
.workspace-main {
  overflow: visible !important;
}
.workspace-content {
  overflow: visible !important;
  -webkit-overflow-scrolling: touch !important;
}
/* Never let decorative layers steal the finger gesture. */
.hero:before,
.identity:after,
.profile-cover:after,
.install-banner,
.app-toast {
  pointer-events: none;
}
/* Keep actual controls clickable. */
button, a, input, textarea, select, label {
  touch-action: manipulation;
}
/* Scrollable inner surfaces must accept vertical finger scrolling. */
.onboard-card,
.admin-table-wrap,
.chat-people-list,
.chat-messages,
.bottom-sheet,
.drawer-nav {
  touch-action: pan-y !important;
  -webkit-overflow-scrolling: touch !important;
}
@media (max-width:760px){
  html, body { min-height:100dvh; }
  #app.app-shell { min-height:100dvh; height:auto !important; }
  .workspace-main { min-height:100dvh; height:auto !important; }
  .workspace-content { min-height:calc(100dvh - 70px); padding-bottom:calc(110px + env(safe-area-inset-bottom)) !important; }
}


/* V52 — release-grade touch/scroll architecture */
html { height:auto !important; min-height:100%; }
body { min-height:100dvh !important; height:auto !important; overflow-y:auto !important; overscroll-behavior:none; }
.app-shell { min-height:100dvh !important; height:auto !important; }
.workspace-main { min-height:100dvh !important; height:auto !important; overflow:visible !important; }
.workspace-content { height:auto !important; min-height:calc(100dvh - 70px); overflow:visible !important; }
.view.active { min-height:calc(100dvh - 100px); }
@media (max-width:760px){
  body, .app-shell, .workspace-main, .workspace-content { touch-action:pan-y pinch-zoom !important; }
  .workspace-content { padding-bottom:calc(120px + env(safe-area-inset-bottom)) !important; }
  .mobile-drawer, .drawer-nav { overscroll-behavior:contain; }
  .chat-shell { overflow:visible !important; }
  .chat-people-list { overscroll-behavior:contain; }
  .chat-messages { overscroll-behavior:contain; }
}
/* Decorative/transparent layers must never capture the finger. */
.identity-card:before, .identity-card:after, .profile-cover:after, .hero:before { pointer-events:none !important; }
/* Real controls remain tappable while the page itself remains swipe-scrollable. */
button, a, input, textarea, select { -webkit-tap-highlight-color:transparent; }
.field-hint { color:#888; font-size:9px; line-height:1.4; }
